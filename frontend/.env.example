# Ключ авторизации GigaChat (base64 client_id:client_secret).
# Держится ТОЛЬКО на сервере (dev-прокси Vite), в клиентский бандл не попадает —
# переменная намеренно без префикса VITE_.
# Скопируйте этот файл в .env.local и подставьте свой ключ.
GIGACHAT_AUTH_KEY=

# Режим API: mock (по умолчанию) — весь бэкенд эмулируется MSW.
# live — каталог тянется с реального бэкенда (/api/v1/catalog), очередь остаётся
# на моках (гибрид), пока бэкенд не выкатит эндпоинты очереди.
VITE_API_MODE=mock
