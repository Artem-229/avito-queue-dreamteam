# Переменные для docker compose. Скопируйте файл в .env и подставьте значения.
# Сам .env закоммичен быть не должен — он в .gitignore.

# Ключ авторизации GigaChat: base64 от "client_id:client_secret" из личного
# кабинета. Нужен для векторов каталога, на которых работает подбор похожих
# лотов. Без ключа приложение стартует штатно, но прогрев векторов падает с 401,
# и GET /catalog/:id/similar отвечает 500, а alternatives приходят пустыми.
GIGACHAT_AUTH_KEY=

# Ключ админ-панели (/admin на фронте, /api/v1/admin/* в API). Значение
# произвольное. Если не задан — compose подставит admin-local-dev-key; на
# публичном стенде обязательно задайте своё.
ADMIN_SECRET_KEY=

# Секрет подписи сессий, минимум 32 байта. Приложение не стартует без него;
# для локального запуска compose подставляет дев-значение по умолчанию.
AUTH_SESSION_SECRET=

# Флаг Secure на куке сессии. На локальном http должен быть false, иначе
# браузер не сохранит куку. На HTTPS-стенде — true.
AUTH_SECURE_COOKIE=false

# Демо-ручки /demo/simulate и /demo/expire-now. Нужны для показа сценария,
# поэтому в compose включены. expire-now сжигает права всех пользователей
# товара — на публичном стенде это кнопка «сломать демонстрацию».
DEMO_ENABLED=true
